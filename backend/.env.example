DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/questionbank
PORT=4000
# Select `ollama` for local LLM generation, `groq` for cloud generation, or `local` for the built-in generator.
AI_PROVIDER=ollama
# Local LLM service. Start the Radeon Vulkan server with backend/start-ollama-gpu.ps1.
OLLAMA_BASE_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen3.5:4b
# Keep the secret only in backend/.env. Never commit that file.
# Optional Groq fallback/provider settings:
# AI_PROVIDER=groq
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-20b
# Optional Python executable for retraining our classifiers.
# PYTHON_COMMAND=python
