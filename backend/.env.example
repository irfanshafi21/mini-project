DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/questionbank
PORT=4000
# Select `groq` for syllabus question generation or `local` for the built-in generator.
AI_PROVIDER=groq
# Keep the secret only in backend/.env. Never commit that file.
GROQ_API_KEY=PASTE_YOUR_GROQ_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-20b
# Optional Python executable for retraining our classifiers.
# PYTHON_COMMAND=python
